+	path          string
+	authorization string
+	body          []byte
+}
+
+type hostRecordingRecoveryFixture struct {
+	*hostRunFixture
+	mu          sync.Mutex
+	mode        string
+	requests    []hostRecordingRecoveryRequest
+	retained    map[int][]byte
+	through     int
+	started     chan struct{}
+	terminated  chan struct{}
+	proved      chan struct{}
+	release     chan struct{}
+	startOnce   sync.Once
+	endOnce     sync.Once
+	proofOnce   sync.Once
