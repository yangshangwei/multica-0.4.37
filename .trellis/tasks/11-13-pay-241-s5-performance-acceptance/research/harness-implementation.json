        "COLLABORATION_PERF_MANIFEST",
        "DATABASE_URL",
        "NEXT_PUBLIC_API_URL",
        "MULTICA_DEPLOYMENT_ID"
      ],
      "optional": [
        "COLLABORATION_E2E_API_URL (same origin if set)"
      ],
      "writeback_only": [
        "COLLABORATION_HOST_DAEMON",
        "COLLABORATION_HOST_PROVIDER",
        "COLLABORATION_HOST_CLI",
        "COLLABORATION_PERF_PROVIDER_SOURCE"
      ]
    },
    "api_preconditions": [
      "password mode",
      "ALLOW_SIGNUP not false",
      "no REDIS_URL, one process",
      "DATABASE_MAX_CONNS unset or not above 25",
      "managed installations available for write-back"
    ],
    "gate": "prepare and propagation need enabled=true and creation_enabled=true at allocation and never change the gate; write-back opens and restores it through openHostAcceptanceGate.",
    "manifest_fields": [
      "schema_version=1",
      "run_id",
      "purpose (rehearsal|acceptance)",
      "seed",
      "protocol (must equal PERFORMANCE_PROTOCOL key for key)",
      "source",
