      "propagation-rounds.jsonl",
      "propagation-samples.jsonl",
      "summary-propagation.json",
      "failures-propagation.json",
      "writeback-runs.jsonl",
      "writeback-samples.jsonl",
      "summary-writeback.json",
      "failures-writeback.json"
    ],
    "rerun_rule": "Once a phase has created its samples file the run directory cannot be reused for that phase; a NOT_RUN attempt that wrote no sample may be repeated."
  },
