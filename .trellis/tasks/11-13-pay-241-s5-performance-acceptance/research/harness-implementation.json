      "database.name",
      "gate_original.{enabled,creation_enabled,host_execution_enabled,epoch}",
      "binaries.{provider_source_sha256,provider_sha256,daemon_sha256,cli_sha256} (write-back)"
    ],
    "protocol": {
      "observers": 100,
      "warmupEvents": 5,
      "formalEvents": 100,
      "propagationDeadlineMs": 10000,
      "propagationBudgetMs": 2000,
      "relayPeriodMs": 500,
      "writebackWarmupRuns": 1,
      "writebackFormalRuns": 100,
      "writebackDeadlineMs": 30000,
      "writebackBudgetMs": 5000,
      "registrationWindowMs": 300000,
      "registrationPerWindow": 30,
      "registrationMarginMs": 2000
    },
    "run_directory_layout": [
      "manifest.json",
      "private/prepare-state.json (0600)",
      "prepare-log.jsonl",
      "setup-identities.json",
      "observed-<phase>-<UTC>.json",
      "resources-<phase>-<UTC>-before.json",
