@@ -0,0 +1,30 @@
+package collaborationrun
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/multica-ai/multica/server/pkg/protocol"
+)
+
+// Context audit 2026-10-29: a squad member run receives the group's root human
+// inputs (claimPromptSnapshot selects by group). The claim carries
+// HostContext.Role and StepKey, but hostPrompt drops them, so the Provider is
+// told to "process the following authorized collaboration inputs" with no sign
+// that its task is the leader's delegation rather than the whole request.
+func TestHostPromptTellsAMemberRunItsRoleAndStep(t *testing.T) {
+	parent := "00000000-0000-4000-8000-0000000000aa"
+	claim := protocol.CollaborationRunClaimResponse{AgentID: "member-agent",
+		HostContext: &protocol.CollaborationHostContext{Role: "member", StepKey: "dispatch-1", ParentRunID: &parent},
+		Preparation: &protocol.CollaborationPreparation{},
+		Inputs:      []protocol.CollaborationRunInput{{CommandID: "root-command", Body: "Ship the whole feature"}}}
+	prompt, err := hostPrompt(claim, false, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, want := range []string{`"role":"member"`, `"step_key":"dispatch-1"`} {
+		if !strings.Contains(prompt, want) {
+			t.Errorf("member prompt omits %s, so the Provider cannot tell a delegated step from the root request:\n%s", want, prompt)
+		}
+	}
+}
diff --git a/server/internal/handler/collaboration_runtime_comment_size_test.go b/server/internal/handler/collaboration_runtime_comment_size_test.go
new file mode 100644
index 000000000..c208d8f0d
--- /dev/null
+++ b/server/internal/handler/collaboration_runtime_comment_size_test.go
@@ -0,0 +1,42 @@
+package handler
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/google/uuid"
+	"github.com/multica-ai/multica/server/internal/testutil"
+)
+
+// Context audit 2026-10-29: the runtime CLI posts comments with json.Marshal
+// (cmd_collaboration.go:141 -> cli.PostJSON), which escapes each <, > and & to
+// six bytes. The runtime decoder caps the raw body at 96 KiB, while the comment
+// limit is 64 KiB of decoded content (collaboration_mentions.go:119). A body
+// of D decoded bytes with a fraction f of escaped characters is sent as about
+// D*(1+5f) bytes, so a pasted HTML snippet under 64 KiB is refused as 413.
+func TestCollaborationRuntimeCommentBodyAcceptsCodeWithinTheContentLimit(t *testing.T) {
+	content := strings.Repeat("<div><span>&nbsp;</span></div>\n", 1600) // 49,600 bytes decoded
+	if len(content) > 64<<10 {
+		t.Fatalf("fixture exceeds the comment limit: %d bytes", len(content))
+	}
+	raw, err := json.Marshal(map[string]any{"comment_id": uuid.NewString(), "parent_id": nil, "content": content})
+	if err != nil {
+		t.Fatal(err)
+	}
+	req := httptest.NewRequest(http.MethodPost, "/runtime/comments", strings.NewReader(string(raw)))
+	req.Header.Set("Content-Type", "application/json")
+	var body struct {
+		CommentID string  `json:"comment_id"`
+		ParentID  *string `json:"parent_id"`
+		Content   string  `json:"content"`
+	}
+	testutil.Call(t, func(w http.ResponseWriter, r *http.Request) {
+		if decodeCollaborationRuntimeBody(w, r, &body) {
+			w.WriteHeader(http.StatusNoContent)
+		}
+	}, req).Want(http.StatusNoContent)
+	t.Logf("decoded %d bytes, sent %d bytes as CLI JSON", len(content), len(raw))
+}
