          "role": "initiator",
          "username_bytes": 29
        },
        {
          "role": "external-handler",
          "username_bytes": 32
        }
      ],
      "password_ascii_characters": 42,
      "display_name_characters": [
        29,
        36
      ],
      "contracts": [
        {
          "file": "server/internal/auth/password.go",
          "line": 22,
          "sha256": "817794cc7464d663fb4fe3a8c9bd3f1ea8011664ffd3ea39648a5d4264c6feb5",
          "behavior": "NormalizeUsername trims, enforces byte length 3–32 and ASCII letters/numbers/underscore, then lowercases; password is 6–128 characters / at most 512 bytes and name is 1–80 characters."
        },
        {
          "file": "server/internal/handler/auth_password.go",
          "line": 109,
          "sha256": "dff65b4ae923433b8342102a384687dd484df0c3b94f990e6b7dd87e28cc9737",
          "behavior": "PasswordRegister still enforces configured password availability, limiter, AllowSignup and the original account validator before hashing/transaction."
        }
      ],
      "product_auth_validation_or_policy_relaxed": false
    },
    {
      "id": "PASSWORD-ACTOR-2",
      "severity": "info",
      "status": "reviewed_no_blocker",
      "finding": "Password actors now use the unchanged real registration client, PATCH /api/me/onboarding with questionnaire.source=[friends_colleagues], and bodyless POST /api/me/onboarding/complete. Completion ID must match the registered user ID and onboarded_at must be non-null. The subsequent /api/me and browser login identity checks remain unchanged.",
      "contracts": [
        {
          "file": "e2e/fixtures.ts",
          "line": 71,
          "sha256": "ec055f2f87f06bc18dbf0c5234a1ef5d4aefaba19f12395b48c97c19616506f2",
          "behavior": "Register requires a successful HTTP response, usable token and string user ID. requestJSON requires response.ok; authedFetch sends that bearer token."
        },
        {
          "file": "server/cmd/server/router.go",
          "line": 1848,
          "sha256": "99b8add17fa3251ec830a0069e8477c67c74a83626a62a829228685142bf4b11",
          "behavior": "Onboarding PATCH and completion POST are in the Auth/TaskCapabilityGuard/InstallationMetadata middleware group."
