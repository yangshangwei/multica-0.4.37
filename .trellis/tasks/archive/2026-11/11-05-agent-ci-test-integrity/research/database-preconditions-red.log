        func TestUserTableIsQuoted(t *testing.T) {
        	f := newFixture(t)
        
        	userID := f.User(t, "Quoted Name", "testutil-quoted@multica.ai")
        	var name string
        	f.QueryRow(t, `SELECT name FROM "user" WHERE id = $1`, userID).Scan(&name)
        	if name != "Quoted Name" {
        		t.Fatalf("name = %q, want Quoted Name", name)
        	}
        }
        
