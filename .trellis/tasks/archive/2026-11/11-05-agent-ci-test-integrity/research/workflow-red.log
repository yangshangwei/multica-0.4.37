  expected:
  actual: |-
        runs-on: ubuntu-latest
        outputs:
          tag_name: ${{ steps.release_meta.outputs.tag_name }}
          is_stable: ${{ steps.release_meta.outputs.is_stable }}
        steps:
          - name: Checkout
            uses: actions/checkout@v4
            with:
              fetch-depth: 0
    
          - name: Validate tag name
            id: release_meta
            shell: bash
            run: |
              tag="${GITHUB_REF_NAME}"
              echo "Triggered by tag: $tag"
              if [[ ! "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]]; then
                echo "::error::Release tags must look like vX.Y.Z or vX.Y.Z-suffix; got '$tag'."
                exit 1
              fi
              if [[ "$tag" == *-dirty* ]]; then
                echo "::error::Refusing to release from dirty tag '$tag'."
                exit 1
              fi
              echo "tag_name=$tag" >> "$GITHUB_OUTPUT"
              if [[ "$tag" == *-* ]]; then
                echo "is_stable=false" >> "$GITHUB_OUTPUT"
              else
                echo "is_stable=true" >> "$GITHUB_OUTPUT"
              fi
    
          # The combined offline archive tests run the desktop update-artifacts
          # helper, which imports electron-updater from apps/desktop/node_modules.
          - name: Setup pnpm
            uses: pnpm/action-setup@v4
    
          - name: Setup Node for changelog checks
            uses: actions/setup-node@v4
            with:
              node-version: 22
              cache: pnpm
    
          - name: Install dependencies
            run: pnpm install --frozen-lockfile
    
          - name: Verify changelog generation, publication and release graph
            run: node --test scripts/*changelog*.test.mjs
    
          - name: Setup Go
            uses: actions/setup-go@v5
            with:
              # Deliberately independent from the minimum patch in server/go.mod:
              # releases follow the newest 1.26 patch available to setup-go.
              go-version: "1.26.x"
              check-latest: true
              cache-dependency-path: server/go.sum
    
          - name: Record Go toolchain
            run: go version
    
          - name: Verify Go test wrapper
            run: bash scripts/test-go.test.sh
    
          - name: Run tests
            run: bash scripts/test-go.sh --race
    
          - name: Scan Go vulnerabilities
            # Fail closed unless an administrator scopes the documented emergency
            # override to this exact tag. See .github/RELEASING.md.
            if: ${{ vars.ALLOW_VULN_BYPASS_FOR_TAG != github.ref_name }}
            working-directory: server
            run: go tool govulncheck ./...
    
          - name: Record emergency vulnerability-scan bypass
            if: ${{ vars.ALLOW_VULN_BYPASS_FOR_TAG == github.ref_name }}
            run: echo "::warning::govulncheck was explicitly skipped for ${GITHUB_REF_NAME}; see .github/RELEASING.md"
    
    
