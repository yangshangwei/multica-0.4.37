  "resource_probe_source": "package main\n\nimport (\n \"context\"\n \"encoding/json\"\n \"os\"\n \"time\"\n \"github.com/jackc/pgx/v5\"\n)\nfunc main() {\n ctx,cancel:=context.WithTimeout(context.Background(),5*time.Second);defer cancel()\n conn,err:=pgx.Connect(ctx,os.Getenv(\"DATABASE_URL\"));if err!=nil {os.Exit(2)};defer conn.Close(ctx)\n var database string;var connections,total int;var users,workspaces,comments int64\n if err=conn.QueryRow(ctx,`SELECT current_database(),(SELECT count(*) FROM pg_stat_activity WHERE datname=current_database()),(SELECT count(*) FROM pg_stat_activity), (SELECT count(*) FROM \"user\"),(SELECT count(*) FROM workspace),(SELECT count(*) FROM comment)`).Scan(&database,&connections,&total,&users,&workspaces,&comments);err!=nil {os.Exit(3)}\n if database!=os.Getenv(\"TASK_DATABASE_NAME\") {os.Exit(4)}\n _=json.NewEncoder(os.Stdout).Encode(map[string]any{\"database\":database,\"database_connections\":connections,\"cluster_connections\":total,\"users\":users,\"workspaces\":workspaces,\"comments\":comments})\n}\n",
