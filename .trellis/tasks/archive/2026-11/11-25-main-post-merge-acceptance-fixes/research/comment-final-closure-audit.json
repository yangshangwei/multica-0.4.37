          "file": "server/internal/handler/comment_authority_test.go",
          "diff": [
            "--- \n",
            "+++ \n",
            "@@ -1,13 +1,80 @@\n",
            " package handler",
            " ",
            " import (",
            "+\t\"context\"",
            " \t\"net/http\"",
            "+\t\"net/http/httptest\"",
            " \t\"testing\"",
            " ",
            " \t\"github.com/google/uuid\"",
            "+\t\"github.com/multica-ai/multica/server/internal/auth\"",
            " \t\"github.com/multica-ai/multica/server/internal/events\"",
            " \t\"github.com/multica-ai/multica/server/internal/testutil\"",
            "+\tdb \"github.com/multica-ai/multica/server/pkg/db/generated\"",
            " )",
            "+",
            "+func TestCommentMutationActorVerifiedIdentity(t *testing.T) {",
            "+\tuserID, workspaceID, agentID, taskID := uuid.NewString(), uuid.NewString(), uuid.NewString(), uuid.NewString()",
            "+\ttoken := db.TaskToken{ID: parseUUID(uuid.NewString()), UserID: parseUUID(userID), WorkspaceID: parseUUID(workspaceID), AgentID: parseUUID(agentID), TaskID: parseUUID(taskID)}",
            "+\tfor _, scenario := range []struct {",
            "+\t\tname           string",
            "+\t\tkind           auth.CredentialKind",
            "+\t\tverified       bool",
            "+\t\twrongUser      bool",
            "+\t\twrongWorkspace bool",
            "+\t\tmissingAgent   bool",
            "+\t\tstampedTask    bool",
            "+\t\tallowed        bool",
            "+\t\tactorType      string",
            "+\t}{",
            "+\t\t{name: \"human ignores agent hints\", kind: auth.CredentialJWT, allowed: true, actorType: \"member\"},",
            "+\t\t{name: \"PAT ignores agent hints\", kind: auth.CredentialPAT, allowed: true, actorType: \"member\"},",
            "+\t\t{name: \"cloud retains member identity\", kind: auth.CredentialCloud, allowed: true, actorType: \"member\"},",
            "+\t\t{name: \"verified task retains agent\", kind: auth.CredentialTask, verified: true, stampedTask: true, allowed: true, actorType: \"agent\"},",
            "+\t\t{name: \"task without verified binding\", kind: auth.CredentialTask, stampedTask: true},",
            "+\t\t{name: \"stamped task without context\", kind: auth.CredentialJWT, stampedTask: true},",
            "+\t\t{name: \"binding for other user\", kind: auth.CredentialTask, verified: true, wrongUser: true},",
            "+\t\t{name: \"binding for other workspace\", kind: auth.CredentialTask, verified: true, wrongWorkspace: true},",
            "+\t\t{name: \"binding lacks agent\", kind: auth.CredentialTask, verified: true, missingAgent: true},",
            "+\t\t{name: \"task binding contradicts human credential\", kind: auth.CredentialJWT, verified: true},",
            "+\t} {",
            "+\t\tt.Run(scenario.name, func(t *testing.T) {",
            "+\t\t\trequest := httptest.NewRequest(http.MethodPut, \"/api/comments/local-fixture\", nil)",
            "+\t\t\trequest.Header.Set(\"X-Agent-ID\", uuid.NewString())",
            "+\t\t\trequest.Header.Set(\"X-Task-ID\", uuid.NewString())",
            "+\t\t\tif scenario.stampedTask {",
            "+\t\t\t\trequest.Header.Set(\"X-Actor-Source\", \"task_token\")",
            "+\t\t\t}",
            "+\t\t\tctx := auth.WithAuthenticatedPrincipal(context.Background(), auth.AuthenticatedPrincipal{UserID: userID, Kind: scenario.kind})",
            "+\t\t\tif scenario.verified {",
            "+\t\t\t\tbinding := token",
            "+\t\t\t\tif scenario.wrongUser {",
            "+\t\t\t\t\tbinding.UserID = parseUUID(uuid.NewString())",
            "+\t\t\t\t}",
            "+\t\t\t\tif scenario.wrongWorkspace {",
            "+\t\t\t\t\tbinding.WorkspaceID = parseUUID(uuid.NewString())",
            "+\t\t\t\t}",
            "+\t\t\t\tif scenario.missingAgent {",
            "+\t\t\t\t\tbinding.AgentID.Valid = false",
            "+\t\t\t\t}",
            "+\t\t\t\tctx = auth.WithVerifiedTaskToken(ctx, binding)",
            "+\t\t\t}",
            "+\t\t\tactorType, actorID, allowed := commentMutationActor(request.WithContext(ctx), userID, workspaceID)",
            "+\t\t\tif allowed != scenario.allowed || actorType != scenario.actorType {",
            "+\t\t\t\tt.Fatalf(\"actor type=%q allowed=%v\", actorType, allowed)",
            "+\t\t\t}",
            "+\t\t\tif allowed {",
            "+\t\t\t\twantID := userID",
            "+\t\t\t\tif actorType == \"agent\" {",
            "+\t\t\t\t\twantID = agentID",
            "+\t\t\t\t}",
            "+\t\t\t\tif actorID != wantID {",
            "+\t\t\t\t\tt.Fatal(\"mutation actor does not match verified credential\")",
            "+\t\t\t\t}",
            "+\t\t\t}",
            "+\t\t})",
            "+\t}",
            "+}",
            " ",
            " // Auth stamps these sources in production. Direct calls prove that moving the",
            " // routes cannot silently drop the credential gate inside either handler."
          ]
        }
      ],
