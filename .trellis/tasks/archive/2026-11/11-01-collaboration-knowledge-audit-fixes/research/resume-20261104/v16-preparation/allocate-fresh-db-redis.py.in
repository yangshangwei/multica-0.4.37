from pathlib import Path
from datetime import datetime, timezone
import hashlib
import json
import os
import shlex
import socket
import subprocess
import time
from urllib.parse import urlsplit, unquote

HERE = Path(__file__).resolve().parent
ROOT = Path('/Volumes/artisan/code/2026/mc-collaboration-closure-v12-20261103')
OUT = ROOT / '.omx/private/final-check-v16'
EXPECTED = 'PENDING_ROOT_FINAL_SHA'
OWNER = '01a1a3c9-2459-7de1-8244-55640c5f6143'
PSQL = '/opt/homebrew/opt/libpq/bin/psql'

def digest(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()

def save(name, value):
    path = HERE / name
    with path.open('x') as target:
        json.dump(value, target, indent=2)
        target.write('\n')
    path.chmod(0o600)

def run(args, **kwargs):
    return subprocess.run(args, capture_output=True, text=True, check=True, **kwargs)

assert run(['git', 'rev-parse', 'HEAD'], cwd=ROOT).stdout.strip() == EXPECTED
assert not run(['git', 'status', '--porcelain'], cwd=ROOT).stdout.strip()
values = {}
for line in (OUT / 'check-source-v16.env').read_text().splitlines():
    if line and not line.startswith('#'):
        key, raw = line.split('=', 1)
        tokens = shlex.split(raw)
        values[key] = tokens[0] if tokens else ''
url = urlsplit(values['DATABASE_URL'])
database = 'multica_closure_v16_seed_01a1a3c9'
assert url.path == '/' + database and values['POSTGRES_DB'] == database
sql_env = {'PATH': '/usr/bin:/bin', 'HOME': str(OUT / 'metadata-home-not-created'),
           'PGHOST': url.hostname, 'PGPORT': str(url.port), 'PGUSER': unquote(url.username),
           'PGPASSWORD': unquote(url.password), 'PGDATABASE': 'postgres', 'PGSSLMODE': 'disable',
           'PGCONNECT_TIMEOUT': '5', 'PGOPTIONS': '-c statement_timeout=30000'}
sql_cmd = [PSQL, '-X', '-v', 'ON_ERROR_STOP=1', '-At', '-c']
identity = json.loads(run(sql_cmd + ["SELECT json_build_object('database',current_database(),'server_addr',inet_server_addr(),'server_port',inet_server_port(),'server_version',version(),'max_connections',current_setting('max_connections'),'connections',(SELECT count(*) FROM pg_stat_activity))"], env=sql_env).stdout)
assert not run(sql_cmd + ["SELECT 1 FROM pg_database WHERE datname='" + database + "'"], env=sql_env).stdout.strip()
redis_port = urlsplit(values['REDIS_URL']).port
renderer_port = urlsplit(values['COLLABORATION_ELECTRON_RENDERER_URL']).port
for port in (redis_port, renderer_port):
    with socket.socket() as sock:
        sock.bind(('127.0.0.1', port))
record = {'recorded_at': datetime.now(timezone.utc).isoformat(), 'coordinator': OWNER, 'candidate_sha': EXPECTED,
          'candidate_root': str(ROOT), 'source_env_path': str(OUT / 'check-source-v16.env'),
          'source_env_sha256': digest(OUT / 'check-source-v16.env'), 'database': database,
          'postgres_endpoint': {'host': url.hostname, 'port': url.port}, 'postgres_identity': identity,
          'database_state': 'allocation_ready_not_created', 'redis_port': redis_port, 'renderer_port': renderer_port,
          'redis_name': 'multica-v16-01a1a3c9-redis', 'redis_image': 'redis:7-alpine',
          'renderer_url': values['COLLABORATION_ELECTRON_RENDERER_URL'], 'renderer_started': False,
          'future_registry': str(OUT / 'dev-registry-v16'), 'registry_created': False,
          'allocation': json.loads((OUT / 'build-temp-allocation-v16.json').read_text()),
          'script_sha256': digest(__file__), 'real_provider_allowed': False, 'knowledge_default': False}
save('resource-allocation-before.json', record)
result = run(sql_cmd + ['CREATE DATABASE "' + database + '" WITH TEMPLATE template0 OWNER "multica"'], env=sql_env)
actual = run(sql_cmd + ['SELECT current_database()'], env={**sql_env, 'PGDATABASE': database}).stdout.strip()
assert actual == database
record.update(database_state='created_empty', database_create_exit=result.returncode, actual_database=actual)
save('resource-allocation-created.json', record)
image = json.loads(run(['/usr/local/bin/docker', 'image', 'inspect', record['redis_image']]).stdout)[0]
record['redis_image_id'] = image['Id']
docker_cmd = ['/usr/local/bin/docker', 'run', '--pull=never', '-d', '--name', record['redis_name'],
              '--label', 'multica.task.owner=' + OWNER, '--label', 'multica.candidate=' + EXPECTED,
              '-p', '127.0.0.1:' + str(redis_port) + ':6379', record['redis_image'],
              'redis-server', '--save', '', '--appendonly', 'no']
container = run(docker_cmd).stdout.strip()
inspection = json.loads(run(['/usr/local/bin/docker', 'inspect', container]).stdout)[0]
assert inspection['Image'] == image['Id'] and inspection['State']['Running']
assert inspection['Config']['Labels']['multica.task.owner'] == OWNER
reply = b''
for attempt in range(20):
    try:
        with socket.create_connection(('127.0.0.1', redis_port), timeout=1) as sock:
            sock.sendall(b'*1\r\n$4\r\nPING\r\n')
            reply = sock.recv(128)
        if reply == b'+PONG\r\n':
            break
    except OSError:
        pass
    time.sleep(0.1)
assert reply == b'+PONG\r\n'
record.update(redis_started=True, redis_container_id=container, redis_command=docker_cmd,
              redis_ping='PONG', redis_port_binding=inspection['NetworkSettings']['Ports']['6379/tcp'],
              redis_inspection={'image_id': inspection['Image'], 'pid': inspection['State']['Pid'],
                                'started_at': inspection['State']['StartedAt'], 'labels': inspection['Config']['Labels']})
save('resource-allocation-redis.json', record)
print(json.dumps({'candidate_sha': EXPECTED, 'database': actual, 'connections_before': identity['connections'],
                  'max_connections': identity['max_connections'], 'redis_port': redis_port, 'redis_container': container,
                  'renderer_port_reserved_in_record': renderer_port, 'renderer_started': False, 'registry_created': False}))
