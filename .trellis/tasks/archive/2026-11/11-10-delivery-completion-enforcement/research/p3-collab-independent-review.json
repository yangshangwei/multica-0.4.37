    {
      "id": "C-R1",
      "finding": "Union receipt conversion removed exact original authorization/before/after checks and admitted wrong consumer/variant retained facts",
      "fix": "Restore authorization and operation IDs, exact before and strictly advancing after revision, mutation digest, actor and closed target variant bindings; refuse mismatched collaboration/admin/submission/provider fact shapes",
