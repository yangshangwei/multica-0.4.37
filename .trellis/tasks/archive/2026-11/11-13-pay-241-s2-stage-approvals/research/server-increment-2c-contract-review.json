  "updated_at": "2026-11-14T08:42:09.031036+00:00",
  "coordinator_resolution": "Coordinator accepted 2C-R01–R03 and requested final minimum freeze rules. No product/wire edits or implementation acceptance in this review.",
  "technical_amendments": [
    {
      "id": "2C-R01",
      "proposal_lines": [
        53,
        57,
        59,
        78,
        138
      ],
      "title": "Separate stable physical-target conflict key from versioned approval target digest",
      "counterexample": "Pending intent under binding/configA; reconnect or another root/workspace resolves same external target underB; local/digest-scoped lock permits a second operation.",
      "minimal_repair": "Trusted resolver returns versioned target_digest plus stable conflict-domain key excluding root/workspace/local integration and mutable trust/config identifiers. Serialize unresolved query and insertion on existing transaction advisory namespace across all local bindings; hide foreign-operation identifiers.",
      "tests": [
        "same target across roots",
        "same target after reconnect",
        "same target across local workspace bindings",
        "same display name for unrelated targets"
      ],
      "status": "accepted_for_owner_freeze_not_yet_implemented"
    },
    {
      "id": "2C-R02",
      "proposal_lines": [
        45,
        53,
        63,
        64,
        65,
        66
      ],
      "title": "Define enforceable single-use and dispatch-deadline semantics after definite intent commit",
      "counterexample": "A legitimate caller reuses a handle or reaches invocation after its stored dispatch deadline; unexported/nonserializable alone does not consume it.",
      "minimal_repair": "Synchronous service-owned one-shot handoff after definite intent commit. No cached/serializable permit escapes; atomically consume entry once and check its bounded deadline immediately before callback entry. Keep exact original external key/target/build/conditional version.",
      "tests": [
        "same handle twice",
        "concurrent handle use",
        "postcommit expiry",
        "ambiguous commit",
        "restart/original-key receipt returns no permit"
      ],
      "status": "accepted_for_owner_freeze_not_yet_implemented",
      "outcomes": [
        {
          "when": "Intent commit failed or ambiguous",
          "result": "Zero entries, no opportunity returned; retained intent remains unresolved until original-key reconciliation."
        },
        {
          "when": "Live sole guard detects deadline/cancellation before callback entry",
          "result": "Permanently retire entry and make zero external calls. Internal-only not_started observation may be persisted, bound to original intent/executor and sole-entry proof; no native operation ID and no execution fact."
        },
        {
          "when": "Pre-entry not_started persistence fails or is ambiguous",
          "result": "Unresolved/unknown; history recovery only, no recreated opportunity or invocation."
        },
        {
          "when": "Process dies without conclusive observation after commit",
          "result": "Pending/unknown; loss of a memory guard does not prove not_started."
