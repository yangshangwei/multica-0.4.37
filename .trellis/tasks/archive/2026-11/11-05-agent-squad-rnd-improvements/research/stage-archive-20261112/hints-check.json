  "fixed_findings": [
    {
      "id": "HINT-1",
      "issue": "Core legacy classifier downgraded structured error aliases",
      "fix": "Preserve structured error_code/resource/permission_code/delivery_code refusal; four red cases now pass."
    },
    {
      "id": "HINT-2",
      "issue": "Explicit retry reused a stale issue revision",
      "fix": "Reload current workspace-scoped issue with cancellable GET before retry; close old result before starting replacement read."
    },
    {
      "id": "HINT-3",
      "issue": "Unmounted owner could still confirm a previously displayed hint",
      "fix": "Keep controller ownership until completion; aborted owner cannot confirm or retry."
    },
    {
      "id": "HINT-4",
      "issue": "Repeated confirmation could invoke the mutation twice and pending cleared before real mutation settled",
      "fix": "Consume confirmation once and return promises completed by actual mutation onSettled in each scoped adapter."
    },
    {
      "id": "HINT-5",
      "issue": "Collaboration-source actions could be intercepted by ordinary completion hint API",
      "fix": "Shared gate delegates collaboration source to existing workflow; regression proves no ordinary hint request."
    }
  ],
