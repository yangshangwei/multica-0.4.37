+                    "MULTICA_TASK_PACKAGE_DB_MODE": "0", "MULTICA_TASK_PACKAGE_DB_EVIDENCE": str(self.evidence),
+                    "DATABASE_URL": "postgres://127.0.0.1:5432/" + CLONE}
