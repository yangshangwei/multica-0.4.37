FROM node:22-bookworm

RUN npm install --global @openai/codex@0.164.0 \
    && install -d -m 0755 /work /work/tasks /root/.codex /root/.codex/multica-sessions \
    && install -d -o node -g node -m 0755 /work/lab /home/node/.codex \
    && install -d -m 0700 /root/.multica /root/.multica/profiles \
    && chmod 0711 /root

COPY multica /usr/local/bin/multica
COPY codex-pilot /usr/local/bin/codex-pilot
RUN chmod 0755 /usr/local/bin/multica /usr/local/bin/codex-pilot

WORKDIR /work
CMD ["sleep", "infinity"]
