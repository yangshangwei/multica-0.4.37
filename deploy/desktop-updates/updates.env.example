# Copy to updates.env beside docker-compose.desktop-updates.yml and edit once.
# Set IMAGE to the tag printed by export-image for the download server's CPU.
DESKTOP_UPDATES_IMAGE=multica-desktop-nginx:985220252f38-amd64
DESKTOP_UPDATES_BIND=0.0.0.0
DESKTOP_UPDATES_PORT=18080
DESKTOP_UPDATES_STORAGE=/srv/multica-updates
# Client-visible directory, not an installer URL or the client's localhost.
DESKTOP_UPDATES_URL=http://10.10.10.20:18080/desktop
