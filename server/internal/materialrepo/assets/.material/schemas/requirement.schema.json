{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Material requirement",
  "description": "Structural format only; authority, readiness and actual evidence are verified by the owning workflow.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "affected_modules",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "type": {
      "const": "requirement"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "affected_modules": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository_id",
          "commit",
          "path"
        ],
        "properties": {
          "repository_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "commit": {
            "type": "string",
            "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)\\.[gG][iI][tT](?:/|$))(?!.*//)(?!.*[\\\\%?#:\\x00-\\x1f\\x7f-\\x9f])(?!.*(?:^|/)[\\x20\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])(?!.*[\\x20\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](?:/|$))[^/]+(?:/[^/]+)*$"
          }
        }
      }
    }
  }
}
